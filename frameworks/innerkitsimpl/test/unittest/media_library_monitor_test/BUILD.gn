import("//build/test.gni")
import("//foundation/multimedia/media_library/media_library.gni")

group("unittest") {
  testonly = true
  deps = [ ":media_library_monitor_test" ]
}

ohos_unittest("media_library_monitor_test") {
  module_out_path = "media_library/media_library_monitor"

  include_dirs = [
    "./include",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_library_monitor/include",
    "${MEDIALIB_INTERFACES_PATH}/inner_api/media_library_helper/include",
  ]

  sources = [
    "${MEDIALIB_NEW_SERVICES_PATH}/media_library_monitor/src/media_library_monitor.cpp",
    "./src/media_library_monitor_test.cpp",
  ]

  cflags_cc = [ "-fno-access-control" ]

  external_deps = [
    "hilog:libhilog",
    "googletest:gtest_main",
  ]
}
