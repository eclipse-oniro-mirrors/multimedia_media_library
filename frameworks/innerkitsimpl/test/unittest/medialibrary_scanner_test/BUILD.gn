import("//build/test.gni")
import("//foundation/multimedia/media_library/media_library.gni")

group("unittest") {
  testonly = true

  deps = [ ":medialibrary_scanner_test" ]
}

ohos_unittest("medialibrary_scanner_test") {
  module_out_path = "media_library/media_library_asset"
  include_dirs = [
    "./include",
    "../get_self_permissions/include",
    "${MEDIALIB_INTERFACES_PATH}/inner_api/media_library_helper/include",
    "${MEDIALIB_INNERKITS_PATH}/media_library_helper/include",
    "${MEDIALIB_UTILS_PATH}/include",
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include",
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension/include",
    "../medialibrary_unittest_utils/include",
    "${MEDIALIB_INTERFACES_PATH}/inner_api/media_library_helper/include",
    "${MEDIALIB_THUMBNAIL_PATH}/include",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner/concurrent",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner/concurrent/handler",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner/concurrent/resolver",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner/config",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner/strategy",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/scanner/converter",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/include/callback",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_custom_restore/include",
  ]

  sources = [
    "../medialibrary_unittest_utils/src/medialibrary_unittest_utils.cpp",
    "./src/metadata_extractor_test.cpp",
    "./src/medialibrary_scanner_test.cpp",
    "./src/deduplication_handler_test.cpp",
    "./src/quality_conflict_resolver_test.cpp",
    "./src/resolver_registry_test.cpp",
    "./src/enhanced_scan_executor_test.cpp",
    "./src/scan_config_test.cpp",
    "./src/custom_restore_types_test.cpp",
    "./src/metadata_get_value_test.cpp",
    "./src/scanner_utils_custom_restore_test.cpp",
    "./src/custom_restore_strategy_test.cpp",
    "./src/custom_restore_scanner_obj_test.cpp",
    "./src/media_scanner_manager_custom_restore_test.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/strategy/custom_restore_strategy.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/custom_restore_scanner_obj.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_custom_restore/src/custom_restore_utils.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/metadata.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/config/scan_config.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/config/scan_config_builder.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/config/default_scan_info.cpp",
    "${MEDIALIB_NEW_SERVICES_PATH}/media_scanner/src/scanner/config/custom_restore_info.cpp",
  ]
  deps = [
    "${MEDIALIB_INNERKITS_PATH}/media_library_helper:media_library",
    "${MEDIALIB_COMMON_PATH}:media_library_common",
    "${MEDIALIB_INNERKITS_PATH}/medialibrary_data_extension:medialibrary_data_extension",
    "${MEDIALIB_UTILS_PATH}:permission_utils",
  ]

  external_deps = [
    "ability_base:want",
    "ability_base:zuri",
    "ability_runtime:ability_connect_callback_stub",
    "ability_runtime:ability_context_native",
    "ability_runtime:ability_manager",
    "ability_runtime:app_context",
    "ability_runtime:dataobs_manager",
    "ability_runtime:runtime",
    "access_token:libaccesstoken_sdk",
    "access_token:libprivacy_sdk",
    "bundle_framework:appexecfwk_core",
    "c_utils:utils",
    "common_event_service:cesfwk_innerkits",
    "data_share:datashare_common",
    "data_share:datashare_provider",
    "googletest:gmock",
    "graphic_surface:surface",
    "hilog:libhilog",
    "ipc:ipc_single",
    "image_framework:image_native",
    "kv_store:distributeddata_inner",
    "libuv:uv",
    "media_foundation:media_foundation",
    "napi:ace_napi",
    "node:node_header_notice",
    "player_framework:media_client",
    "relational_store:native_rdb",
  ]

  cflags = [ "-fno-access-control" ]

  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }

  if (is_standard_system) {
    external_deps += [ "hilog:libhilog" ]
  } else {
    external_deps += [ "hilog:libhilog" ]
  }

  resource_config_file =
      "${MEDIALIB_INNERKITS_PATH}/test/unittest/resources/ohos_test.xml"
}